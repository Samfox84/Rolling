{
  "name": "rolling-desk",
  "productName": "Rolling Desk",
  "version": "0.3.2",
  "description": "The producer's desk for a Rolling studio: connect to your studio server, or host the whole studio on this computer. The audio Console, show control, and every recording saved on this computer.",
  "main": "main.js",
  "author": "Sam Fox (made with Claude, Anthropic)",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/Samfox84/Rolling",
  "scripts": {
    "start": "electron .",
    "prepare:studio": "node scripts/prepare-studio.js",
    "tools": "node scripts/fetch-tools.js",
    "dist:mac": "electron-builder --mac dmg zip --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "43.8.7",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.samfox84.rolling-desk",
    "productName": "Rolling Desk",
    "files": [
      "main.js",
      "preload.js",
      "connect.html",
      "connect-preload.js",
      "mirror.js",
      "updater.js",
      "host.js",
      "activity.js",
      "icon.png",
      "studio/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Rolling-Desk-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.music",
      "icon": "icon.png",
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Rolling Desk uses your microphone only when you hold Talkback to speak to someone on the show.",
        "NSCameraUsageDescription": "Rolling Desk doesn't record you; the camera is only used if you join the show on camera."
      }
    },
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "maintainer": "Sam Fox",
      "synopsis": "Producer's desk for a Rolling podcast studio"
    },
    "publish": [],
    "extraResources": [
      {
        "from": "vendor/tools",
        "to": "tools"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "asar": false
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^4.21.2",
    "nodemailer": "^10.3.1",
    "ws": "^8.18.0"
  }
}
