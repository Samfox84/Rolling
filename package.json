{
  "name": "rolling",
  "version": "0.9.1",
  "description": "Self-hosted remote podcast studio: video call + lossless per-person audio and per-person video recording",
  "main": "server.js",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.js",
    "test:desk": "xvfb-run -a node --test tests/e2e/desk-app.e2e.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^4.21.2",
    "nodemailer": "^10.3.1",
    "ws": "^8.18.0"
  }
}
